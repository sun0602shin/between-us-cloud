rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace both values with the anonymous Firebase UIDs shown on the phones.
    function familyMember() {
      return request.auth != null && request.auth.uid in [
        'PASTE_MOM_UID_HERE',
        'PASTE_DAUGHTER_UID_HERE'
      ];
    }
    match /rooms/family-sync-test/notes/{noteId} {
      allow read: if familyMember();
      allow create: if familyMember()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == noteId
        && request.resource.data.keys().hasOnly(['id','role','text','updatedAt','ownerUid'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 3000
        && request.resource.data.role in ['mom','daughter'];
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
