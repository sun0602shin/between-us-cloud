rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function mom() { return request.auth != null && request.auth.uid == 'PASTE_MOM_UID_HERE'; }
  function daughter() { return request.auth != null && request.auth.uid == 'PASTE_DAUGHTER_UID_HERE'; }
  function member() { return mom() || daughter(); }
  // Preserve the prior memo test rules; the test app continues working.
  match /rooms/family-sync-test/notes/{noteId} {
   allow read: if member();
   allow create: if member() && request.resource.data.ownerUid == request.auth.uid
     && request.resource.data.id == noteId
     && request.resource.data.keys().hasOnly(['id','role','text','updatedAt','ownerUid'])
     && request.resource.data.text is string && request.resource.data.text.size() <= 3000
     && request.resource.data.role in ['mom','daughter'];
   allow update, delete: if false;
  }
  match /rooms/family-sync-v9-lab/records/{recordId} {
   allow read: if member();
   allow create: if member() && request.resource.data.keys().hasOnly(['collection','record','ownerUid'])
    && request.resource.data.collection in ['daily','messages','transactions','categories','agreements','checks','restrictions','rewards','requests','photos','cardTypes','proposals']
    && recordId == request.resource.data.collection + '__' + request.resource.data.record.id
    && request.resource.data.record.updatedAt is string
    && request.resource.data.ownerUid == request.auth.uid
    && ((mom() && request.resource.data.record.owner == 'mom') || (daughter() && request.resource.data.record.owner == 'daughter'));
   allow update: if member() && request.resource.data.collection == resource.data.collection
    && request.resource.data.record.id == resource.data.record.id
    && request.resource.data.record.updatedAt is string
    && request.resource.data.record.updatedAt >= resource.data.record.updatedAt
    && request.resource.data.ownerUid == request.auth.uid
    && ((mom() && (resource.data.record.owner == 'mom' || (resource.data.collection in ['proposals','requests'] && resource.data.record.owner == 'daughter')))
       || (daughter() && resource.data.record.owner == 'daughter'));
   allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
